#!/usr/bin/env bash
#MISE description="Build the debug APK"
#USAGE flag "--release" help "Build the signed release APK instead of debug"
#USAGE flag "--play" help "Build the Google Play flavor (Play Billing tips) instead of foss (Ko-fi link)"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/..}"

# foss is the flavorless default build; -Pplay adds the play flavor.
if [ "${usage_play:-false}" = "true" ]; then
    gradle=(./gradlew -Pplay); Flavor="Play"; out="play/"; name="play-"
else
    gradle=(./gradlew); Flavor=""; out=""; name=""
fi
if [ "${usage_release:-false}" = "true" ]; then
    "${gradle[@]}" "assemble${Flavor}Release"
    echo "APK: app/build/outputs/apk/${out}release/app-${name}release.apk"
else
    "${gradle[@]}" "assemble${Flavor}Debug"
    echo "APK: app/build/outputs/apk/${out}debug/app-${name}debug.apk"
fi
